{
  "name": "@ufa/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node ../../scripts/build-content-runtime.mjs public/content-script.js",
    "dev": "pnpm content && vite",
    "build": "pnpm content && vite build",
    "build:e2e": "pnpm content && vite build --mode e2e --outDir dist-e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@ufa/autofill-sdk": "workspace:*",
    "@ufa/core": "workspace:*",
    "@ufa/extension-bridge": "workspace:*",
    "@ufa/storage": "workspace:*",
    "@ufa/ui": "workspace:*",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
