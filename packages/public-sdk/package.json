{
  "name": "@universal-form-autofill/sdk",
  "version": "0.1.0",
  "description": "Headless form autofill engine, React panel and extension bridge for Chrome extensions.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./extension": "./src/extension.ts",
    "./content": "./src/content.ts",
    "./style.css": "./style.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@ufa/autofill-sdk": "workspace:*",
    "@ufa/core": "workspace:*",
    "@ufa/extension-bridge": "workspace:*",
    "@ufa/field-detection": "workspace:*",
    "@ufa/form-actions": "workspace:*",
    "@ufa/matching-engine": "workspace:*",
    "@ufa/storage": "workspace:*",
    "@ufa/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3"
  }
}
